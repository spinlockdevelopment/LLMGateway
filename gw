# ── Log file setup ───────────────────────────────────────────────────────────

def _setup_log_file() -> None:
    """Set up a log file at <data_dir>/logs/gw.log, overwritten each run."""
    try:
        log_path = log_dir() / "gw.log"
        log_path.parent.mkdir(parents=True, exist_ok=True)
        logging.basicConfig(
            filename=str(log_path),
            filemode="w",  # overwrite each run
            level=logging.DEBUG,
            format="%(asctime)s [%(levelname)-8s] %(message)s",
            datefmt="%Y-%m-%d %H:%M:%S",
        )
    except Exception:
        pass  # non-fatal — console output still works


def _log(msg: str, level: str = "INFO") -> None:
    """Write to the log file (timestamps + levels). Does NOT print to console."""
    getattr(logging, level.lower(), logging.info)(msg)


# ── Setup config (which components are enabled) ──────────────────────────────

def _load_setup_config() -> dict:
    """Load setup-config.yaml. Returns empty dict on failure."""
    path = setup_config_path()
    if not path.exists():
        return {}
    try:
        # Try PyYAML first (available if venv active)
        import yaml
        return yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except ImportError:
        # Fallback: simple key: value parser for flat YAML
        result = {}
        try:
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if ":" in line:
                    key, _, val = line.partition(":")
                    val = val.strip()
                    if val.lower() == "true":
                        result[key.strip()] = True
                    elif val.lower() == "false":
                        result[key.strip()] = False
                    else:
                        result[key.strip()] = val
        except Exception:
            pass
        return result
    except Exception:
        return {}


_OBSERVABILITY_COMPONENTS = ("grafana", "prometheus", "loki", "alloy")


def _observability_enabled() -> bool:
    """Whether the optional Grafana stack is enabled for this install.

    Defaults to False — the lean stack (LiteLLM + Postgres + the management
    UI's built-in Logs panel) is the install default. Users opt in via
    the Services panel toggle.
    """
    return bool(_load_setup_config().get("install_observability", False))


def _enabled_components() -> set[str]:
    """Return set of component names that should appear in status."""
    config = _load_setup_config()
    # Always show core components
    components = {
        "management", "docker",
        "litellm", "postgres", "open-webui",
        "hermes-dashboard",
    }
    # Observability stack is opt-in (default off)
    if config.get("install_observability", False):
        components.update(_OBSERVABILITY_COMPONENTS)
    return components


# ── Status check helpers ──────────────────────────────────────────────────────

def _http_ok(url: str, timeout: int = 2) -> bool:
    """Return True if HTTP GET succeeds."""
    try:
        resp = urllib.request.urlopen(url, timeout=timeout)
        return 200 <= resp.status < 400
    except Exception:
        return False


def _process_running(pattern: str) -> bool:
    """Return True if a process matching the pattern is running."""
    try:
        result = subprocess.run(
            ["pgrep", "-qf", pattern],
            capture_output=True, timeout=5,
        )
        return result.returncode == 0
    except Exception:
        return False


def docker_available() -> bool:
    try:
        result = subprocess.run(["docker", "info"], capture_output=True, timeout=10)
        return result.returncode == 0
    except Exception:
        return False


def docker_container_state(container: str) -> str:
    """Returns: running | starting | stopped | unhealthy | absent"""
    try:
        result = subprocess.run(
            ["docker", "inspect", "--format", "{{.State.Status}}", container],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode != 0:
            return "absent"
        status = result.stdout.strip()
        if status == "running":
            health_result = subprocess.run(
                ["docker", "inspect", "--format",
                 "{{if .State.Health}}{{.State.Health.Status}}{{end}}", container],
                capture_output=True, text=True, timeout=10,
            )
            health = health_result.stdout.strip()
            return "unhealthy" if health == "unhealthy" else "running"
        elif status in ("exited", "dead"):
            return "stopped"
        elif status == "restarting":
            return "starting"
        return status
    except Exception:
        return "absent"


def management_state() -> str:
    if _http_ok(f"http://localhost:{MANAGEMENT_PORT}/"):
        return "running"
    if _process_running("llmgateway.py"):
        return "starting"
    try:
        result = subprocess.run(
            ["launchctl", "list"], capture_output=True, text=True, timeout=10,
        )
        if MANAGEMENT_LABEL in result.stdout:
            return "stopped"
    except Exception:
        pass
    if MANAGEMENT_PLIST.exists():
        return "stopped"
    return "absent"


def _management_json(path: str, method: str = "GET", timeout: float = 5.0):
    """Call the management API; return parsed JSON, or None if it is down."""
    req = urllib.request.Request(f"{MANAGEMENT_URL}{path}", method=method)
    if method != "GET":
        req.add_header("content-type", "application/json")
        req.data = b"{}"
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        try:
            return json.loads(exc.read())
        except Exception:
            return {"error": f"HTTP {exc.code}"}
    except Exception:
        return None


def _host_services() -> list[dict]:
    """Host model servers supervised by management (empty if it is down)."""
    data = _management_json("/api/status")
    return (data or {}).get("services", [])


# ── Display helpers ───────────────────────────────────────────────────────────

def _status_color(state: str) -> callable:
    return {
        "running": green,
        "starting": yellow,
    }.get(state, red)


def _status_icon(state: str) -> str:
    return {"running": "●", "starting": "◐"}.get(state, "○")


def _status_label(state: str) -> str:
    return "not found" if state == "absent" else state


def print_row(name: str, state: str, endpoint: str = "", desc: str = "", proc: str = "") -> None:
    """Print one status row: icon, name, state, endpoint, process, description."""
    color = _status_color(state)
    icon = _status_icon(state)
    label = _status_label(state)

    line = f"  {color(icon)} {name:<14s} {color(f'{label:<12s}')}"
    if endpoint:
        line += f"  {cyan(f'{endpoint:<36s}')}"
    else:
        line += f"  {'':36s}"
    if proc:
        line += f"  {dim(f'{proc:<18s}')}"
    else:
        line += f"  {'':18s}"
    if desc:
        line += f"  {dim(desc)}"
    info(line)
    _log(f"  {name}: {label} {endpoint} {proc} {desc}")


def print_path(label: str, path: str, desc: str = "") -> None:
    """Print a path row with exists/missing indicator."""
    expanded = str(Path(path).expanduser()) if path.startswith("~") else path
    if not os.path.isabs(expanded):
        expanded = str(REPO_DIR / expanded)

    mark = green("✓") if os.path.exists(expanded) else dim("·")
    info(f"  {mark}  {dim(f'{label:<12s}')}  {path:<45s}  {dim(desc)}")


def print_volume(name: str, desc: str = "") -> None:
    """Print a Docker volume row with exists indicator."""
    try:
        result = subprocess.run(
            ["docker", "volume", "inspect", name],
            capture_output=True, timeout=10,
        )
        mark = green("✓") if result.returncode == 0 else dim("·")
    except Exception:
        mark = dim("·")
    info(f"  {mark}  {dim('volume'):<16s}  {name:<45s}  {dim(desc)}")


# ── Docker compose helper ────────────────────────────────────────────────────

def _compose_cmd(*args: str) -> list[str]:
    """Build a docker compose command for read-only/teardown use (ps, logs, down).

    No --env-file: this shell can't read the data dir (macOS TCC), and an
    `up` without it would recreate containers with empty keys. Anything that
    (re)creates containers goes through the management service instead.
    """
    cmd = ["docker", "compose", "-f", str(COMPOSE_FILE)]
    if _observability_enabled():
        cmd.extend(["--profile", "observability"])
    cmd.extend(args)
    return cmd


def _compose_containers() -> list[str]:
    """Container names of every compose service (running or not)."""
    result = subprocess.run(_compose_cmd("ps", "-a", "--format", "{{.Name}}"),
                            capture_output=True, text=True, timeout=15)
    return [ln.strip() for ln in result.stdout.splitlines() if ln.strip()]


def _venv_python_for_repo(repo_dir: Path) -> str | None:
    """Return the repo's venv Python executable path if it exists."""
    candidates = [
        repo_dir / ".venv" / "bin" / "python3",
        repo_dir / ".venv" / "bin" / "python",
    ]
    for candidate in candidates:
        if candidate.exists():
            return str(candidate.resolve())
    return None


def _resolve_container(name: str) -> str:
    """Map user-facing component name to its container name."""
    return {
        "litellm": "llm-gateway",
        "postgres": "llm-postgres", "db": "llm-postgres",
        "redis": "llm-redis",
        "open-webui": "open-webui",
        "presidio-analyzer": "presidio-analyzer",
        "presidio-anonymizer": "presidio-anonymizer",
        "grafana": "grafana",
        "prometheus": "prometheus",
        "loki": "loki",
        "alloy": "alloy",
    }.get(name, "")


def _container_action(action: str, container: str) -> bool:
    """start/stop a container directly; restart = recreate via management.

    Restart recreates (`up -d --no-deps --force-recreate`) so a rotated key
    or image bump lands; `docker restart` would keep the old env and image.
    """
    if action != "restart":
        return subprocess.run(["docker", action, container]).returncode == 0
    resp = _management_json(f"/ui/docker/container/{container}/restart", "POST", timeout=180)
    if resp is None:
        error("Management service is down — it runs container recreates. Start it first.")
        return False
    if resp.get("error") or resp.get("detail"):
        error(str(resp.get("error") or resp.get("detail")))
        return False
    return True


def _host_service_action(action: str, name: str) -> bool:
    """start/stop/restart a host model server through the management API."""
    resp = _management_json(f"/ui/services/{name}/{action}", "POST")
    if resp is None:
        error("Management service is down — host services run under it.")
        return False
    if resp.get("error") or resp.get("detail"):
        error(str(resp.get("error") or resp.get("detail")))
        return False
    return True


def _pgrep_pid_label(pattern: str, label: str) -> str:
    """Return a 'label:pid' string for the first matching process, or empty."""
    try:
        result = subprocess.run(
            ["pgrep", "-fl", pattern],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode == 0 and result.stdout:
            pid = result.stdout.splitlines()[0].strip().split()[0]
            return f"{label}:{pid}"
    except Exception:
        pass
    return ""


def _spawn_detached(cmd: list[str]) -> None:
    """Launch a long-running process detached from this terminal."""
    subprocess.Popen(
        cmd,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


# ── "all" orchestration ──────────────────────────────────────────────────────

def _ordered_components_for_stop() -> list[str]:
    """Return enabled components in safe stop order: front-facing first, backends last."""
    enabled = _enabled_components()
    # Front-facing → backends. Docker stack is treated as one unit (compose down).
    candidates = ["management", "docker"]
    return [c for c in candidates if c in enabled]


def _ordered_components_for_start() -> list[str]:
    """Return enabled components in safe start order: backends first, front-facing last."""
    return list(reversed(_ordered_components_for_stop()))


def _all_action(action: str) -> None:
    """Run start/stop/restart for every enabled component in the appropriate order."""
    if action == "stop":
        components = _ordered_components_for_stop()
        for c in components:
            cmd_stop(c)
    elif action == "start":
        components = _ordered_components_for_start()
        for c in components:
            cmd_start(c)
    elif action == "restart":
        info(f"  {bold('Full teardown + restart')}")
        blank()
        info(f"  {dim('Stopping all components...')}")
        for c in _ordered_components_for_stop():
            cmd_stop(c)
        blank()
        time.sleep(2)
        info(f"  {dim('Starting all components...')}")
        for c in _ordered_components_for_start():
            cmd_start(c)
        blank()
        success("All components restarted.")
        _log("Restarted all components")


# ── Commands ──────────────────────────────────────────────────────────────────

def cmd_status(show_more: bool = False) -> None:
    """Show status of all components and key paths."""
    enabled = _enabled_components()
    data_dir = get_data_dir()

    def _prefer_tilde(p: Path) -> str:
        """Return a user-friendly path, preferring ~/ for items under the home directory."""
        try:
            home = Path.home().resolve()
            resolved = p.expanduser().resolve()
            rel = resolved.relative_to(home)
            return f"~/{rel}"
        except Exception:
            return str(p)

    blank()
    info(f"  {bold('LLM Gateway — Status')}  {dim(datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))}")
    blank()

    # Determine hostname for public .local endpoints.
    host = socket.gethostname().split(".")[0] or "localhost"
    public_host = f"{host}.local"

    header = f"{'COMPONENT':<15s} {'STATUS':<12s} {'ENDPOINT':<38s} {'PROCESS':<18s} DESCRIPTION"
    info(f"  {dim(header)}")
    separator()
    blank()

    # Bare-metal services
    public_rows = []
    internal_rows = []

    if "management" in enabled:
        public_rows.append((
            "management",
            management_state(),
            f"http://{public_host}:{MANAGEMENT_PORT}",
            "Gateway web UI + REST API",
            _pgrep_pid_label("llmgateway.py", "llmgateway.py"),
        ))

    # Host model servers, as the management service supervises them.
    for svc in _host_services():
        internal_rows.append((
            svc["name"],
            svc.get("state", "?"),
            f"http://localhost:{svc['port']}" if svc.get("port") else "",
            svc.get("description", ""),
            f"pid:{svc['pid']}" if svc.get("pid") else "",
        ))

    blank()

    # Docker containers
    if not docker_available():
        icon = red("○")
        name = "docker".ljust(14)
        status = red("unavailable".ljust(12))
        message = dim("Docker daemon not running")
        info(f"  {icon} {name} {status}  {message}")
        blank()
    else:
        docker_rows = [
            ("llm-gateway",  "litellm",    f"http://{public_host}:4000", "LiteLLM proxy (UI → /ui)"),
            ("llm-postgres", "postgres",   "localhost:5432",             "PostgreSQL — spend tracking"),
            ("open-webui",   "open-webui", f"http://{public_host}:3001", "Open WebUI chat front-end"),
            ("grafana",      "grafana",    f"http://{public_host}:3000", "Grafana dashboards"),
            ("prometheus",   "prometheus", f"http://{public_host}:9090", "Prometheus metrics"),
            ("loki",         "loki",       f"http://{public_host}:3100", "Loki log aggregation"),
            ("alloy",        "alloy",      "",                           "Grafana Alloy collector"),
            # Not part of docker-compose.yml — a standalone container managed
            # directly via `docker start/stop`, not `docker compose`.
            ("hermes-dashboard", "hermes-dashboard", "http://localhost:9119", "Hermes agent dashboard (external)"),
        ]
        for container, display, endpoint, desc in docker_rows:
            if display in enabled:
                state = docker_container_state(container)
                proc = ""
                try:
                    pid_result = subprocess.run(
                        ["docker", "inspect", "--format", "{{.State.Pid}}", container],
                        capture_output=True, text=True, timeout=5,
                    )
                    if pid_result.returncode == 0:
                        pid = pid_result.stdout.strip()
                        if pid and pid != "0":
                            proc = f"docker:{container}:{pid}"
                except Exception:
                    pass
                row = (display, state, endpoint, desc, proc)
                if endpoint.startswith(f"http://{public_host}"):
                    public_rows.append(row)
                else:
                    internal_rows.append(row)

    # Sort and print rows: public endpoints first, then internal/none.
    def _endpoint_key(row: tuple[str, str, str, str, str]) -> tuple[int, str]:
        _, _, ep, _, _ = row
        if ep.startswith(f"http://{public_host}"):
            group = 0
        elif ep:
            group = 1
        else:
            group = 2
        return (group, ep)

    public_rows_sorted = sorted(public_rows, key=_endpoint_key)
    internal_rows_sorted = sorted(internal_rows, key=_endpoint_key)

    for name, state, ep, desc, proc in public_rows_sorted:
        print_row(name, state, ep, desc, proc)

    if internal_rows_sorted:
        blank()
        for name, state, ep, desc, proc in internal_rows_sorted:
            print_row(name, state, ep, desc, proc)

    blank()

    # Service accounts
    info(f"\n  {dim('Service accounts')}")
    blank()
    user = os.environ.get("USER", "unknown")
    info(f"  {'Host (local):':<18s} {bold(user)}  {dim('management + host model servers')}")
    info(f"  {'PostgreSQL:':<18s} {bold('litellm')}  {dim('LiteLLM DB (docker stack)')}")

    # Read Grafana user from .env (only relevant when observability is on)
    if _observability_enabled():
        grafana_user = "admin"
        env_file = data_dir / ".env"
        if env_file.exists():
            try:
                for line in env_file.read_text(errors="replace").splitlines():
                    if line.startswith("GF_SECURITY_ADMIN_USER="):
                        val = line.split("=", 1)[1].strip().strip("'\"")
                        if val:
                            grafana_user = val
            except Exception:
                pass
        info(f"  {'Grafana admin:':<18s} {bold(grafana_user)}  {dim('docker stack (.env)')}")
    blank()

    # Key paths (condensed by default)
    header = f"{'PATH':<15s} {'TYPE':<12s} {'':38s} DESCRIPTION"
    info(f"  {dim(header)}")
    separator()

    info(f"\n  {dim('Config files')}")
    blank()
    setup_path = data_dir / "setup-config.yaml"
    secrets_path = data_dir / ".env"
    defaults_path = REPO_DIR / "config" / "llmgateway.defaults.yaml"
    user_cfg_path = data_dir / "config" / "llmgateway.yaml"
    litellm_cfg_path = REPO_DIR / "config" / "litellm-config.yaml"

    # Order: setup, secrets, then config files.
    print_path("setup", _prefer_tilde(setup_path), "initial setup choices")
    print_path("secrets", _prefer_tilde(secrets_path), "API keys, passwords")
    print_path("config", _prefer_tilde(user_cfg_path), "gateway overrides")
    print_path("config", _prefer_tilde(litellm_cfg_path), "LiteLLM model routing")

    if show_more:
        print_path("config", _prefer_tilde(defaults_path), "gateway defaults (read-only)")

    info(f"\n  {dim('Logs')}")
    blank()
    print_path("log", _prefer_tilde(MANAGEMENT_LOG), "management service")
    print_path("log", _prefer_tilde(data_dir / "logs" / "gw.log"), "gw script (this run)")

    if show_more:
        info(f"\n  {dim('System')}")
        blank()
        print_path("launchd", f"~/Library/LaunchAgents/{MANAGEMENT_LABEL}.plist", "autostart agent")

        info(f"\n  {dim('Docker stack')}")
        blank()
        print_path("docker", "docker/docker-compose.yml", "docker compose stack definition")
        print_path("docker", "docker/prometheus/prometheus.yml", "Prometheus scrape config")
        print_path("docker", "docker/grafana/provisioning", "Grafana dashboards + data sources")
        print_path("docker", "docker/alloy/alloy-config.alloy", "Grafana Alloy collector config")

        # Docker volumes
        if docker_available():
            compose_project = ""
            try:
                result = subprocess.run(
                    _compose_cmd("config"),
                    capture_output=True, text=True, timeout=15,
                )
                for line in result.stdout.splitlines():
                    if line.startswith("name:"):
                        compose_project = line.split(":", 1)[1].strip()
                        break
            except Exception:
                pass
            if not compose_project:
                compose_project = "docker"

            info(f"\n  {dim('Docker volumes')}")
            blank()
            print_volume(f"{compose_project}_postgres-data", "PostgreSQL DB")
            print_volume(f"{compose_project}_prometheus-data", "Prometheus TSDB")
            print_volume(f"{compose_project}_loki-data", "Loki log chunks")
            print_volume(f"{compose_project}_grafana-data", "Grafana DB + dashboards")

        blank()
        info(f"  {dim(f'Data dir: {_prefer_tilde(data_dir)}')}")
        info(f"  {dim('Commands: gw start|stop|restart|logs <component>  •  gw uninstall')}")
    blank()


# ── Endpoint health probes ────────────────────────────────────────────────────
# `gw` (status) answers "is the process/container up?"; `gw health` answers
# "does the endpoint actually respond correctly?" by hitting each service's
# own health route.

def _http_probe(url: str, timeout: float = 5.0) -> tuple[int, float, str]:
    """GET *url*; return (status_code, elapsed_ms, body). status 0 = no response."""
    start = time.monotonic()
    try:
        resp = urllib.request.urlopen(url, timeout=timeout)
        code, body = resp.status, resp.read(4096).decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        code, body = exc.code, exc.read(4096).decode("utf-8", "replace")
    except Exception as exc:
        code, body = 0, str(getattr(exc, "reason", exc))
    return code, (time.monotonic() - start) * 1000, body


def _json_or_none(body: str):
    try:
        return json.loads(body)
    except Exception:
        return None


def _http_check(name: str, url: str, validate=None) -> dict:
    """Probe an HTTP health endpoint. *validate(body) -> (state, detail)* refines a 2xx."""
    code, ms, body = _http_probe(url)
    if code == 0:
        return {"name": name, "target": url, "state": "down", "code": "---", "ms": ms, "detail": body[:60]}
    if 200 <= code < 400:
        state, detail = validate(body) if validate else ("ok", "")
    else:
        state, detail = "down", " ".join(body.split())[:60]
    return {"name": name, "target": url, "state": state, "code": str(code), "ms": ms, "detail": detail}


def _exec_check(name: str, container: str, argv: list[str], expect: str) -> dict:
    """Run a CLI health command inside a container; ok if *expect* is in stdout."""
    start = time.monotonic()
    try:
        result = subprocess.run(
            ["docker", "exec", container, *argv], capture_output=True, text=True, timeout=10,
        )
        out = (result.stdout or result.stderr).strip()
        state = "ok" if result.returncode == 0 and expect in out else "down"
    except Exception as exc:
        out, state = str(exc), "down"
    return {"name": name, "target": f"docker exec {container} {argv[0]}", "state": state,
            "code": "", "ms": (time.monotonic() - start) * 1000, "detail": out.splitlines()[-1][:60] if out else ""}


def _litellm_ready(body: str) -> tuple[str, str]:
    data = _json_or_none(body) or {}
    db = data.get("db", "?")
    ok = data.get("status") == "healthy" and db == "connected"
    return ("ok" if ok else "degraded"), f"db {db}"


def _grafana_ready(body: str) -> tuple[str, str]:
    data = _json_or_none(body) or {}
    db = data.get("database", "?")
    return ("ok" if db == "ok" else "degraded"), f"v{data.get('version', '?')}, db {db}"


def _loki_check() -> dict:
    """Loki's /ready can sit at 503 ("Ingester not ready: waiting for 15s after
    being ready") indefinitely while ingest + query work fine, so fall back to
    a real query before calling it down."""
    row = _http_check("loki", "http://localhost:3100/ready")
    if row["state"] == "down" and row["code"] != "---":
        code, _, body = _http_probe("http://localhost:3100/loki/api/v1/labels")
        if code == 200 and (_json_or_none(body) or {}).get("status") == "success":
            row["state"] = "degraded"
            row["detail"] = "/ready 503 but queries OK"
    return row


def _management_checks() -> list[dict]:
    """Probe the management API, plus every service it supervises via its health_url."""
    url = f"http://localhost:{MANAGEMENT_PORT}/api/status"
    code, ms, body = _http_probe(url)
    data = _json_or_none(body) if code == 200 else None
    if data is None:
        # Host model servers run under management, so they are down with it.
        return [{"name": "management", "target": url, "state": "down",
                 "code": str(code) if code else "---", "ms": ms, "detail": body[:60]}]

    mem = data.get("memory", {})
    rows = [{"name": "management", "target": url, "state": "ok", "code": "200", "ms": ms,
             "detail": f"mem {mem.get('used_gb', '?')}/{mem.get('total_gb', '?')} GB"}]
    for svc in data.get("services", []):
        if svc.get("state") == "disabled" or not svc.get("health_url"):
            continue
        row = _http_check(f"svc:{svc['name']}", svc["health_url"])
        if svc.get("restart_count"):
            row["detail"] = (row["detail"] + f" restarts={svc['restart_count']}").strip()
        if svc.get("last_error"):
            row["detail"] = (row["detail"] + f" err={svc['last_error']}").strip()[:60]
        rows.append(row)
    return rows


def _tailscale_checks() -> list[dict]:
    """Probe each `tailscale serve` HTTPS listener through its public name.

    MagicDNS often doesn't resolve the node's own name locally, so pin the
    hostname to this node's tailnet IP with curl --resolve.
    """
    if not shutil.which("tailscale") or not shutil.which("curl"):
        return []
    try:
        serve = json.loads(subprocess.run(
            ["tailscale", "serve", "status", "--json"], capture_output=True, text=True, timeout=10,
        ).stdout or "{}")
        ip = subprocess.run(
            ["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=10,
        ).stdout.strip().splitlines()[0]
    except Exception:
        return []

    # Health route per local backend port; fall back to "/".
    health_paths = {"4000": "/health/liveliness", "3001": "/health"}
    rows = []
    for hostport, cfg in (serve.get("Web") or {}).items():
        host, _, port = hostport.rpartition(":")
        backend = (cfg.get("Handlers", {}).get("/", {}) or {}).get("Proxy", "")
        path = health_paths.get(backend.rpartition(":")[2], "/")
        url = f"https://{host}" + ("" if port == "443" else f":{port}") + path
        start = time.monotonic()
        try:
            result = subprocess.run(
                ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "-m", "10",
                 "--resolve", f"{host}:{port}:{ip}", url],
                capture_output=True, text=True, timeout=15,
            )
            code = result.stdout.strip() or "000"
        except Exception:
            code = "000"
        ms = (time.monotonic() - start) * 1000
        ok = code.isdigit() and 200 <= int(code) < 400
        rows.append({"name": f"tailscale:{port}", "target": url, "state": "ok" if ok else "down",
                     "code": code if code != "000" else "---", "ms": ms, "detail": f"→ {backend}"})
    return rows


def _health_checks() -> list[dict]:
    """Run every applicable probe concurrently; return rows in display order."""
    enabled = _enabled_components()
    docker_ok = docker_available()

    def container_up(name: str) -> bool:
        return docker_ok and docker_container_state(name) in ("running", "unhealthy", "starting")

    # Each job returns a list of rows.
    jobs: list[callable] = [_management_checks]
    if "litellm" in enabled:
        jobs += [lambda: [_http_check("litellm", "http://localhost:4000/health/liveliness")],
                 lambda: [_http_check("litellm:ready", "http://localhost:4000/health/readiness", _litellm_ready)]]
    if "postgres" in enabled:
        jobs.append(lambda: [_exec_check("postgres", "llm-postgres", ["pg_isready"], "accepting connections")])
    if container_up("llm-redis"):
        jobs.append(lambda: [_exec_check("redis", "llm-redis", ["redis-cli", "ping"], "PONG")])
    if "open-webui" in enabled:
        jobs.append(lambda: [_http_check("open-webui", "http://localhost:3001/health")])
    if "hermes-dashboard" in enabled and container_up("hermes-dashboard"):
        jobs.append(lambda: [_http_check("hermes-dashboard", "http://localhost:9119/")])
    if "grafana" in enabled or container_up("grafana"):
        jobs.append(lambda: [_http_check("grafana", "http://localhost:3000/api/health", _grafana_ready)])
    if "prometheus" in enabled or container_up("prometheus"):
        jobs.append(lambda: [_http_check("prometheus", "http://localhost:9090/-/ready")])
    if "loki" in enabled or container_up("loki"):
        jobs.append(lambda: [_loki_check()])
    jobs.append(_tailscale_checks)

    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=len(jobs)) as pool:
        results = list(pool.map(lambda job: job(), jobs))
    return [row for rows in results for row in rows]


def cmd_health(as_json: bool = False) -> int:
    """Probe every enabled endpoint's health route. Returns 1 if any is down."""
    rows = _health_checks()
    failed = [r for r in rows if r["state"] == "down"]

    if as_json:
        print(json.dumps({"ok": not failed, "checks": rows}, indent=2))
        return 1 if failed else 0

    blank()
    info(f"  {bold('LLM Gateway — Endpoint health')}  {dim(datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))}")
    blank()
    header = f"{'CHECK':<20s} {'STATE':<9s} {'CODE':<5s} {'TIME':>7s}  {'TARGET':<52s} DETAIL"
    info(f"  {dim(header)}")
    separator()

    color = {"ok": green, "degraded": yellow}
    icon = {"ok": "●", "degraded": "◐"}
    for r in rows:
        c = color.get(r["state"], red)
        ms = f"{r['ms']:.0f}ms"
        info(f"  {c(icon.get(r['state'], '○'))} {r['name']:<18s} {c(r['state'].ljust(9))} "
             f"{r['code']:<5s} {ms:>7s}  {cyan(r['target'][:52].ljust(52))} {dim(r['detail'])}")
        _log(f"  health {r['name']}: {r['state']} {r['code']} {ms} {r['target']} {r['detail']}")

    blank()
    degraded = sum(r["state"] == "degraded" for r in rows)
    summary = f"{len(rows) - len(failed) - degraded}/{len(rows)} ok"
    if degraded:
        summary += f", {degraded} degraded"
    if failed:
        error(f"{summary}, {len(failed)} down: {', '.join(r['name'] for r in failed)}")
    elif degraded:
        warn(summary)
    else:
        success(summary)
    blank()
    return 1 if failed else 0


def _management_action(action: str) -> None:
    """start/stop/restart the management service via launchd."""
    if action in ("stop", "restart"):
        if MANAGEMENT_PLIST.exists():
            subprocess.run(["launchctl", "unload", str(MANAGEMENT_PLIST)], capture_output=True)
        subprocess.run(["pkill", "-f", "llmgateway.py"], capture_output=True)
        if action == "stop":
            return
        time.sleep(1)
    if MANAGEMENT_PLIST.exists():
        subprocess.run(["launchctl", "load", str(MANAGEMENT_PLIST)], capture_output=True)
    else:
        warn("Launchd plist not installed — starting directly.")
        info(f"  {dim('Install with: python3 scripts/llmgateway.py --install')}")
        python_bin = _venv_python_for_repo(REPO_DIR) or sys.executable
        _spawn_detached([python_bin, str(MANAGEMENT_SCRIPT)])


def _docker_stack_action(action: str) -> bool:
    """start/stop every compose container; restart = recreate via management."""
    if action == "restart":
        resp = _management_json("/ui/docker/stack/restart", "POST", timeout=300)
        if resp is None:
            error("Management service is down — it runs container recreates. Start it first.")
            return False
        return not (resp.get("error") or resp.get("detail"))
    containers = _compose_containers()
    if not containers:
        error("No compose containers found. Create them once with the setup script.")
        return False
    return subprocess.run(["docker", action, *containers]).returncode == 0


def cmd_action(action: str, name: str) -> None:
    """start / stop / restart one component."""
    if name == "all":
        _all_action(action)
        return
    verb = {"start": "Starting", "stop": "Stopping", "restart": "Restarting"}[action]
    host_names = {svc["name"] for svc in _host_services()}

    if name in ("management", "gateway"):
        info(f"  {verb} management service...")
        _management_action(action)
        ok = True
    elif name in host_names:
        info(f"  {verb} {name}...")
        ok = _host_service_action(action, name)
    elif name == "docker":
        info(f"  {verb} Docker Compose stack...")
        ok = _docker_stack_action(action)
    elif name == "hermes-dashboard":
        # Standalone container, not in compose; recreate steps live in the
        # update-all skill.
        info(f"  {verb} {name}...")
        ok = subprocess.run(["docker", action, name]).returncode == 0
    elif _resolve_container(name):
        info(f"  {verb} {name}...")
        ok = _container_action(action, _resolve_container(name))
    else:
        error(f"Unknown component: {name}")
        if host_names:
            info(f"  {dim('Host services: ' + ', '.join(sorted(host_names)))}")
        cmd_usage()
        return

    if ok:
        success("Done.")
        _log(f"{action}: {name}")


def cmd_start(name: str) -> None:
    cmd_action("start", name)


def cmd_stop(name: str) -> None:
    cmd_action("stop", name)


def cmd_restart(name: str) -> None:
    cmd_action("restart", name)


def _tail_file(path: Path) -> None:
    info(f"  {dim(f'Tailing {path} (Ctrl-C to stop)...')}")
    try:
        subprocess.run(["tail", "-n", "50", "-f", str(path)])
    except KeyboardInterrupt:
        pass


def cmd_logs(name: str) -> None:
    """Tail logs for a component."""
    if name in ("management", "gateway"):
        if MANAGEMENT_LOG.exists():
            _tail_file(MANAGEMENT_LOG)
        else:
            warn(f"Log not found: {MANAGEMENT_LOG}")
    elif name in {svc["name"] for svc in _host_services()}:
        # Host logs live under the data dir, which this shell can't read
        # (macOS TCC); the management service reads them for us.
        # lean: last 200 lines, no follow; poll /ui/logs/<name>/tail if -f is needed.
        data = _management_json(f"/ui/logs/{name}/tail?lines=200") or {}
        for line in data.get("lines", []):
            print(line)
        if not data.get("lines"):
            warn(data.get("message") or data.get("error") or data.get("detail") or "No log lines.")
    elif name == "docker":
        subprocess.run(_compose_cmd("logs", "-f", "--tail=50"))
    elif name == "hermes-dashboard" or _resolve_container(name):
        try:
            subprocess.run(["docker", "logs", "-f", "--tail=50", _resolve_container(name) or name])
        except KeyboardInterrupt:
            pass
    else:
        error(f"Unknown component: {name}")
        cmd_usage()


def cmd_uninstall() -> None:
    """Deregister all autostart, stop services. Preserve data."""
    blank()
    info(f"  {bold('Uninstall')} — deregister autostart, stop services")
    info(f"  {dim('Docker images and data volumes are preserved.')}")
    blank()

    # 1. Management service
    if MANAGEMENT_PLIST.exists():
        info(f"  Unregistering management launchd agent...")
        subprocess.run(["launchctl", "unload", str(MANAGEMENT_PLIST)], capture_output=True)
        MANAGEMENT_PLIST.unlink(missing_ok=True)
        success("done")
    else:
        info(f"  {dim('Management launchd agent: not installed — skipping')}")
    if _process_running("llmgateway.py"):
        info(f"  Stopping management service process...")
        subprocess.run(["pkill", "-f", "llmgateway.py"], capture_output=True)
        success("done")

    # Host model servers stop with management (registry.stop_all on shutdown).

    # 4. CLI symlink (gw on PATH)
    try:
        sys.path.insert(0, str(REPO_DIR / "scripts"))
        from cli_symlink import uninstall_symlink
        uninstall_symlink(REPO_DIR)
    except Exception:
        pass

    # 5. Setup configuration (safe to remove; does not contain secrets)
    setup_cfg = setup_config_path()
    if setup_cfg.exists():
        info(f"  Removing setup config: {setup_cfg}")
        setup_cfg.unlink(missing_ok=True)
        success("done")
    else:
        info(f"  {dim('Setup config: not found — skipping')}")

    # 5. Docker
    if docker_available():
        info(f"  Stopping Docker Compose stack (images + volumes preserved)...")
        subprocess.run(_compose_cmd("down"), capture_output=True)
        success("done")
    else:
        info(f"  {dim('Docker not available — skipping')}")

    blank()
    info(f"  {yellow('Note:')} To restart:      {cyan('gw start docker')}")
    info(f"  {yellow('Note:')} To reinstall:     {cyan('python3 scripts/llmgateway.py --install')}")
    blank()
    _log("Uninstall completed")


