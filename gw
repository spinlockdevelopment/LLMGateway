#!/usr/bin/env python3
"""
gw — LLM Gateway helper
========================
Usage:
    gw                         Show status of all components + key paths
    gw health [--json]         Probe each endpoint's health route (exit 1 if any down)
    gw start <component>       Start a component (or "all")
    gw stop <component>        Stop a component (or "all")
    gw restart <component>     Restart a component (or "all" for full teardown + restart)
    gw logs <component>        Tail logs for a component
    gw uninstall               Deregister all autostart, stop containers

Components:
    all            Every enabled component (full teardown/restart in safe order)
    management     Gateway management service (llmgateway.py / launchd)
    llama-server   llama.cpp server (bare metal, default port 8081)
    whisper-server whisper.cpp server (bare metal, default port 8083)
    docker         Entire Docker Compose stack
    litellm        LiteLLM proxy container
    postgres       PostgreSQL container
    open-webui     Open WebUI chat front-end container
    grafana        Grafana dashboards container
    prometheus     Prometheus metrics container
    loki           Loki log aggregation container
    alloy          Grafana Alloy collector container
    hermes-dashboard  Hermes agent dashboard (standalone container, not in compose)

Console output: clean, no timestamps. Warnings in yellow, errors in red.
Log file: <data_dir>/logs/gw.log — full timestamps, overwritten each run.
"""

from __future__ import annotations

import datetime
import json
import logging
import os
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

# ── Path setup ────────────────────────────────────────────────────────────────
# Use resolve() FIRST so a PATH symlink (/opt/homebrew/bin/gw) is followed to
# the real repo before taking .parent. The reverse order keeps REPO_DIR at the
# symlink dir and breaks docker-compose / venv path resolution.
REPO_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(REPO_DIR / "scripts"))

# Import shared modules — graceful fallback if something is broken
try:
    from console import (
        info, success, warn, error, bold, dim, green, red, yellow, cyan,
        heading, separator, blank,
    )
    from data_dir import get_data_dir, setup_config_path, log_dir
except ImportError:
    # Minimal fallback if scripts/ is broken
    def info(msg=""): print(msg)
    def success(msg): print(f"  ✓ {msg}")
    def warn(msg): print(f"  ⚠ Warning: {msg}")
    def error(msg): print(f"  ✗ Error: {msg}")
    def bold(t): return t
    def dim(t): return t
    def green(t): return t
    def red(t): return t
    def yellow(t): return t
    def cyan(t): return t
    def heading(t): print(f"\n  {t}")
    def separator(w=88): print(f"  {'─' * w}")
    def blank(): print()
    def get_data_dir(): return Path.home() / ".llm-gateway"
    def setup_config_path(): return get_data_dir() / "setup-config.yaml"
    def log_dir(): return get_data_dir() / "logs"


# ── Constants ─────────────────────────────────────────────────────────────────
COMPOSE_FILE = REPO_DIR / "docker" / "docker-compose.yml"
MANAGEMENT_LABEL = "com.local.llm-gateway"
MANAGEMENT_SCRIPT = REPO_DIR / "scripts" / "llmgateway.py"
MANAGEMENT_PLIST = Path.home() / "Library" / "LaunchAgents" / f"{MANAGEMENT_LABEL}.plist"
MANAGEMENT_PORT = 8080
LLAMA_SERVER_DEFAULT_PORT = 8081
WHISPER_SERVER_DEFAULT_PORT = 8083


# ── Log file setup ───────────────────────────────────────────────────────────

def _setup_log_file() -> None:
    """Set up a log file at <data_dir>/logs/gw.log, overwritten each run."""
    try:
        log_path = log_dir() / "gw.log"
        log_path.parent.mkdir(parents=True, exist_ok=True)
        logging.basicConfig(
            filename=str(log_path),
            filemode="w",  # overwrite each run
            level=logging.DEBUG,
            format="%(asctime)s [%(levelname)-8s] %(message)s",
            datefmt="%Y-%m-%d %H:%M:%S",
        )
    except Exception:
        pass  # non-fatal — console output still works


def _log(msg: str, level: str = "INFO") -> None:
    """Write to the log file (timestamps + levels). Does NOT print to console."""
    getattr(logging, level.lower(), logging.info)(msg)


# ── Setup config (which components are enabled) ──────────────────────────────

def _load_setup_config() -> dict:
    """Load setup-config.yaml. Returns empty dict on failure."""
    path = setup_config_path()
    if not path.exists():
        return {}
    try:
        # Try PyYAML first (available if venv active)
        import yaml
        return yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except ImportError:
        # Fallback: simple key: value parser for flat YAML
        result = {}
        try:
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if ":" in line:
                    key, _, val = line.partition(":")
                    val = val.strip()
                    if val.lower() == "true":
                        result[key.strip()] = True
                    elif val.lower() == "false":
                        result[key.strip()] = False
                    else:
                        result[key.strip()] = val
        except Exception:
            pass
        return result
    except Exception:
        return {}


_OBSERVABILITY_COMPONENTS = ("grafana", "prometheus", "loki", "alloy")


def _observability_enabled() -> bool:
    """Whether the optional Grafana stack is enabled for this install.

    Defaults to False — the lean stack (LiteLLM + Postgres + the management
    UI's built-in Logs panel) is the install default. Users opt in via
    the Services panel toggle.
    """
    return bool(_load_setup_config().get("install_observability", False))


def _enabled_components() -> set[str]:
    """Return set of component names that should appear in status."""
    config = _load_setup_config()
    # Always show core components
    components = {
        "management", "docker",
        "litellm", "postgres", "open-webui",
        "hermes-dashboard",
    }
    # Observability stack is opt-in (default off)
    if config.get("install_observability", False):
        components.update(_OBSERVABILITY_COMPONENTS)
    # Show optional components based on setup config
    if config.get("install_llama_cpp", False):
        components.add("llama-server")
    if config.get("install_whisper", False):
        components.add("whisper-server")
    return components


# ── Status check helpers ──────────────────────────────────────────────────────

def _http_ok(url: str, timeout: int = 2) -> bool:
    """Return True if HTTP GET succeeds."""
    try:
        resp = urllib.request.urlopen(url, timeout=timeout)
        return 200 <= resp.status < 400
    except Exception:
        return False


def _process_running(pattern: str) -> bool:
    """Return True if a process matching the pattern is running."""
    try:
        result = subprocess.run(
            ["pgrep", "-qf", pattern],
            capture_output=True, timeout=5,
        )
        return result.returncode == 0
    except Exception:
        return False


def docker_available() -> bool:
    try:
        result = subprocess.run(["docker", "info"], capture_output=True, timeout=10)
        return result.returncode == 0
    except Exception:
        return False


def docker_container_state(container: str) -> str:
    """Returns: running | starting | stopped | unhealthy | absent"""
    try:
        result = subprocess.run(
            ["docker", "inspect", "--format", "{{.State.Status}}", container],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode != 0:
            return "absent"
        status = result.stdout.strip()
        if status == "running":
            health_result = subprocess.run(
                ["docker", "inspect", "--format",
                 "{{if .State.Health}}{{.State.Health.Status}}{{end}}", container],
                capture_output=True, text=True, timeout=10,
            )
            health = health_result.stdout.strip()
            return "unhealthy" if health == "unhealthy" else "running"
        elif status in ("exited", "dead"):
            return "stopped"
        elif status == "restarting":
            return "starting"
        return status
    except Exception:
        return "absent"


def management_state() -> str:
    if _http_ok(f"http://localhost:{MANAGEMENT_PORT}/"):
        return "running"
    if _process_running("llmgateway.py"):
        return "starting"
    try:
        result = subprocess.run(
            ["launchctl", "list"], capture_output=True, text=True, timeout=10,
        )
        if MANAGEMENT_LABEL in result.stdout:
            return "stopped"
    except Exception:
        pass
    if MANAGEMENT_PLIST.exists():
        return "stopped"
    return "absent"


def _llama_server_active_port() -> int | None:
    """Return the port a healthy llama-server is currently listening on, or None.

    The management daemon launches `services.local` on the port from
    llmgateway.yaml (typically 8082); `gw start llama-server` launches the
    bare-metal slot on LLAMA_SERVER_DEFAULT_PORT (8081). Probe both.
    """
    for port in (LLAMA_SERVER_DEFAULT_PORT, 8082):
        if _http_ok(f"http://localhost:{port}/health"):
            return port
    return None


def llama_server_state() -> str:
    if _llama_server_active_port() is not None:
        return "running"
    if _process_running("llama-server"):
        return "starting"
    try:
        import shutil
        if shutil.which("llama-server"):
            return "stopped"
    except Exception:
        pass
    return "absent"


def whisper_server_state() -> str:
    if _http_ok(f"http://localhost:{WHISPER_SERVER_DEFAULT_PORT}/health"):
        return "running"
    if _process_running("whisper-server"):
        return "starting"
    try:
        import shutil
        if shutil.which("whisper-server"):
            return "stopped"
    except Exception:
        pass
    return "absent"


# ── Display helpers ───────────────────────────────────────────────────────────

def _status_color(state: str) -> callable:
    return {
        "running": green,
        "starting": yellow,
    }.get(state, red)


def _status_icon(state: str) -> str:
    return {"running": "●", "starting": "◐"}.get(state, "○")


def _status_label(state: str) -> str:
    return "not found" if state == "absent" else state


def print_row(name: str, state: str, endpoint: str = "", desc: str = "", proc: str = "") -> None:
    """Print one status row: icon, name, state, endpoint, process, description."""
    color = _status_color(state)
    icon = _status_icon(state)
    label = _status_label(state)

    line = f"  {color(icon)} {name:<14s} {color(f'{label:<12s}')}"
    if endpoint:
        line += f"  {cyan(f'{endpoint:<36s}')}"
    else:
        line += f"  {'':36s}"
    if proc:
        line += f"  {dim(f'{proc:<18s}')}"
    else:
        line += f"  {'':18s}"
    if desc:
        line += f"  {dim(desc)}"
    info(line)
    _log(f"  {name}: {label} {endpoint} {proc} {desc}")


def print_path(label: str, path: str, desc: str = "") -> None:
    """Print a path row with exists/missing indicator."""
    expanded = str(Path(path).expanduser()) if path.startswith("~") else path
    if not os.path.isabs(expanded):
        expanded = str(REPO_DIR / expanded)

    mark = green("✓") if os.path.exists(expanded) else dim("·")
    info(f"  {mark}  {dim(f'{label:<12s}')}  {path:<45s}  {dim(desc)}")


def print_volume(name: str, desc: str = "") -> None:
    """Print a Docker volume row with exists indicator."""
    try:
        result = subprocess.run(
            ["docker", "volume", "inspect", name],
            capture_output=True, timeout=10,
        )
        mark = green("✓") if result.returncode == 0 else dim("·")
    except Exception:
        mark = dim("·")
    info(f"  {mark}  {dim('volume'):<16s}  {name:<45s}  {dim(desc)}")


# ── Docker compose helper ────────────────────────────────────────────────────

def _tts_enabled() -> bool:
    """Whether the Kokoro TTS container is enabled for this install.

    Defaults to False — TTS is opt-in via the Services panel toggle.
    """
    return bool(_load_setup_config().get("install_tts", False))


def _compose_cmd(*args: str, force_observability: bool = False, force_tts: bool = False) -> list[str]:
    """Build docker compose command with --env-file from data_dir.

    When a profile is enabled (or `force_*=True` for the case where the
    caller is explicitly enabling/disabling it), pass `--profile <name>`
    so the profiled services are visible to compose. Without the flag,
    compose hides them from every operation including `down` — which is
    the right behavior for the lean default install.
    """
    cmd = ["docker", "compose", "-f", str(COMPOSE_FILE)]
    if force_observability or _observability_enabled():
        cmd.extend(["--profile", "observability"])
    if force_tts or _tts_enabled():
        cmd.extend(["--profile", "tts"])
    env_file = get_data_dir() / ".env"
    if env_file.exists():
        cmd.extend(["--env-file", str(env_file)])
    cmd.extend(args)
    return cmd


def _venv_python_for_repo(repo_dir: Path) -> str | None:
    """Return the repo's venv Python executable path if it exists."""
    candidates = [
        repo_dir / ".venv" / "bin" / "python3",
        repo_dir / ".venv" / "bin" / "python",
    ]
    for candidate in candidates:
        if candidate.exists():
            return str(candidate.resolve())
    return None


def _resolve_compose_service(name: str) -> str:
    """Map user-facing name to docker compose service name."""
    return {
        "litellm": "litellm",
        "postgres": "postgres", "db": "postgres",
        "open-webui": "open-webui",
        "grafana": "grafana",
        "prometheus": "prometheus",
        "loki": "loki",
        "alloy": "alloy",
    }.get(name, "")


def _pgrep_pid_label(pattern: str, label: str) -> str:
    """Return a 'label:pid' string for the first matching process, or empty."""
    try:
        result = subprocess.run(
            ["pgrep", "-fl", pattern],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode == 0 and result.stdout:
            pid = result.stdout.splitlines()[0].strip().split()[0]
            return f"{label}:{pid}"
    except Exception:
        pass
    return ""


def _spawn_detached(cmd: list[str]) -> None:
    """Launch a long-running process detached from this terminal."""
    subprocess.Popen(
        cmd,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


# Bare-metal services managed via shell commands (binary, install hint, launch argv).
_BARE_METAL_SERVICES: dict[str, tuple[str, str, list[str]]] = {
    "llama-server": (
        "llama-server",
        "brew install llama.cpp",
        ["llama-server", "--host", "0.0.0.0", "--port", str(LLAMA_SERVER_DEFAULT_PORT)],
    ),
    "whisper-server": (
        "whisper-server",
        "brew install whisper-cpp",
        ["whisper-server", "--host", "0.0.0.0", "--port", str(WHISPER_SERVER_DEFAULT_PORT)],
    ),
}


def _start_bare_metal(name: str) -> bool:
    """Start a bare-metal service (llama-server/whisper-server). Returns False if binary missing."""
    binary, hint, argv = _BARE_METAL_SERVICES[name]
    if not shutil.which(binary):
        error(f"{binary} not found. Install: {hint}")
        return False
    _spawn_detached(argv)
    return True


def _brew_service_started(service: str) -> bool:
    """Return True if `brew services list` knows about *service*."""
    try:
        result = subprocess.run(
            ["brew", "services", "list"], capture_output=True, text=True, timeout=15,
        )
        return result.returncode == 0 and service in (result.stdout or "")
    except Exception:
        return False


# ── "all" orchestration ──────────────────────────────────────────────────────

def _ordered_components_for_stop() -> list[str]:
    """Return enabled components in safe stop order: front-facing first, backends last."""
    enabled = _enabled_components()
    # Front-facing → backends. Docker stack is treated as one unit (compose down).
    candidates = [
        "management",
        "llama-server", "whisper-server",
        "docker",
    ]
    return [c for c in candidates if c in enabled]


def _ordered_components_for_start() -> list[str]:
    """Return enabled components in safe start order: backends first, front-facing last."""
    return list(reversed(_ordered_components_for_stop()))


def _all_action(action: str) -> None:
    """Run start/stop/restart for every enabled component in the appropriate order."""
    if action == "stop":
        components = _ordered_components_for_stop()
        for c in components:
            cmd_stop(c)
    elif action == "start":
        components = _ordered_components_for_start()
        for c in components:
            cmd_start(c)
    elif action == "restart":
        info(f"  {bold('Full teardown + restart')}")
        blank()
        info(f"  {dim('Stopping all components...')}")
        for c in _ordered_components_for_stop():
            cmd_stop(c)
        blank()
        time.sleep(2)
        info(f"  {dim('Starting all components...')}")
        for c in _ordered_components_for_start():
            cmd_start(c)
        blank()
        success("All components restarted.")
        _log("Restarted all components")


# ── Commands ──────────────────────────────────────────────────────────────────

def cmd_status(show_more: bool = False) -> None:
    """Show status of all components and key paths."""
    enabled = _enabled_components()
    data_dir = get_data_dir()

    def _prefer_tilde(p: Path) -> str:
        """Return a user-friendly path, preferring ~/ for items under the home directory."""
        try:
            home = Path.home().resolve()
            resolved = p.expanduser().resolve()
            rel = resolved.relative_to(home)
            return f"~/{rel}"
        except Exception:
            return str(p)

    blank()
    info(f"  {bold('LLM Gateway — Status')}  {dim(datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))}")
    blank()

    # Determine hostname for public .local endpoints.
    host = socket.gethostname().split(".")[0] or "localhost"
    public_host = f"{host}.local"

    header = f"{'COMPONENT':<15s} {'STATUS':<12s} {'ENDPOINT':<38s} {'PROCESS':<18s} DESCRIPTION"
    info(f"  {dim(header)}")
    separator()
    blank()

    # Bare-metal services
    public_rows = []
    internal_rows = []

    if "management" in enabled:
        public_rows.append((
            "management",
            management_state(),
            f"http://{public_host}:{MANAGEMENT_PORT}",
            "Gateway web UI + REST API",
            _pgrep_pid_label("llmgateway.py", "llmgateway.py"),
        ))

    if "llama-server" in enabled:
        active_port = _llama_server_active_port() or LLAMA_SERVER_DEFAULT_PORT
        internal_rows.append((
            "llama-server",
            llama_server_state(),
            f"http://0.0.0.0:{active_port}",
            "llama.cpp GGUF server",
            _pgrep_pid_label("llama-server", "llama-server"),
        ))

    if "whisper-server" in enabled:
        internal_rows.append((
            "whisper-server",
            whisper_server_state(),
            f"http://0.0.0.0:{WHISPER_SERVER_DEFAULT_PORT}",
            "Speech-to-text (whisper.cpp)",
            _pgrep_pid_label("whisper-server", "whisper-server"),
        ))

    blank()

    # Docker containers
    if not docker_available():
        icon = red("○")
        name = "docker".ljust(14)
        status = red("unavailable".ljust(12))
        message = dim("Docker daemon not running")
        info(f"  {icon} {name} {status}  {message}")
        blank()
    else:
        docker_rows = [
            ("llm-gateway",  "litellm",    f"http://{public_host}:4000", "LiteLLM proxy (UI → /ui)"),
            ("llm-postgres", "postgres",   "http://0.0.0.0:5432",        "PostgreSQL — spend tracking"),
            ("open-webui",   "open-webui", f"http://{public_host}:3001", "Open WebUI chat front-end"),
            ("grafana",      "grafana",    f"http://{public_host}:3000", "Grafana dashboards"),
            ("prometheus",   "prometheus", f"http://{public_host}:9090", "Prometheus metrics"),
            ("loki",         "loki",       f"http://{public_host}:3100", "Loki log aggregation"),
            ("alloy",        "alloy",      "",                           "Grafana Alloy collector"),
            # Not part of docker-compose.yml — a standalone container managed
            # directly via `docker start/stop`, not `docker compose`.
            ("hermes-dashboard", "hermes-dashboard", "http://localhost:9119", "Hermes agent dashboard (external)"),
        ]
        for container, display, endpoint, desc in docker_rows:
            if display in enabled:
                state = docker_container_state(container)
                proc = ""
                try:
                    pid_result = subprocess.run(
                        ["docker", "inspect", "--format", "{{.State.Pid}}", container],
                        capture_output=True, text=True, timeout=5,
                    )
                    if pid_result.returncode == 0:
                        pid = pid_result.stdout.strip()
                        if pid and pid != "0":
                            proc = f"docker:{container}:{pid}"
                except Exception:
                    pass
                row = (display, state, endpoint, desc, proc)
                if endpoint.startswith(f"http://{public_host}"):
                    public_rows.append(row)
                else:
                    internal_rows.append(row)

    # Sort and print rows: public endpoints first, then internal/none.
    def _endpoint_key(row: tuple[str, str, str, str, str]) -> tuple[int, str]:
        _, _, ep, _, _ = row
        if ep.startswith(f"http://{public_host}"):
            group = 0
        elif ep:
            group = 1
        else:
            group = 2
        return (group, ep)

    public_rows_sorted = sorted(public_rows, key=_endpoint_key)
    internal_rows_sorted = sorted(internal_rows, key=_endpoint_key)

    for name, state, ep, desc, proc in public_rows_sorted:
        print_row(name, state, ep, desc, proc)

    if internal_rows_sorted:
        blank()
        for name, state, ep, desc, proc in internal_rows_sorted:
            print_row(name, state, ep, desc, proc)

    blank()

    # Service accounts
    info(f"\n  {dim('Service accounts')}")
    blank()
    user = os.environ.get("USER", "unknown")
    info(f"  {'Host (local):':<18s} {bold(user)}  {dim('management, llama-server')}")
    info(f"  {'PostgreSQL:':<18s} {bold('litellm')}  {dim('LiteLLM DB (docker stack)')}")

    # Read Grafana user from .env (only relevant when observability is on)
    if _observability_enabled():
        grafana_user = "admin"
        env_file = data_dir / ".env"
        if env_file.exists():
            try:
                for line in env_file.read_text(errors="replace").splitlines():
                    if line.startswith("GF_SECURITY_ADMIN_USER="):
                        val = line.split("=", 1)[1].strip().strip("'\"")
                        if val:
                            grafana_user = val
            except Exception:
                pass
        info(f"  {'Grafana admin:':<18s} {bold(grafana_user)}  {dim('docker stack (.env)')}")
    blank()

    # Key paths (condensed by default)
    header = f"{'PATH':<15s} {'TYPE':<12s} {'':38s} DESCRIPTION"
    info(f"  {dim(header)}")
    separator()

    info(f"\n  {dim('Config files')}")
    blank()
    setup_path = data_dir / "setup-config.yaml"
    secrets_path = data_dir / ".env"
    defaults_path = REPO_DIR / "config" / "llmgateway.defaults.yaml"
    user_cfg_path = data_dir / "config" / "llmgateway.yaml"
    litellm_cfg_path = data_dir / "litellm-config.yaml"

    # Order: setup, secrets, then config files.
    print_path("setup", _prefer_tilde(setup_path), "initial setup choices")
    print_path("secrets", _prefer_tilde(secrets_path), "API keys, passwords")
    print_path("config", _prefer_tilde(user_cfg_path), "gateway overrides")
    print_path("config", _prefer_tilde(litellm_cfg_path), "LiteLLM model routing")

    if show_more:
        print_path("config", _prefer_tilde(defaults_path), "gateway defaults (read-only)")

    info(f"\n  {dim('Logs')}")
    blank()
    print_path("log", _prefer_tilde(data_dir / "logs" / "gateway.log"), "management service")
    print_path("log", _prefer_tilde(data_dir / "logs" / "gw.log"), "gw script (this run)")

    if show_more:
        info(f"\n  {dim('System')}")
        blank()
        print_path("launchd", f"~/Library/LaunchAgents/{MANAGEMENT_LABEL}.plist", "autostart agent")

        info(f"\n  {dim('Docker stack')}")
        blank()
        print_path("docker", "docker/docker-compose.yml", "docker compose stack definition")
